# 复制为 .env；不建 .env 则使用代码默认值（相对仓库根目录）。
ENV=dev

# 主库路径（本地开发常用绝对路径；Windows 示例见下）
# DB_PATH=D:/DB/financial.db
DB_PATH=./data/financial.db
STOCK_DICT_A_PATH=./data/stock_dict_a.npy
OUTPUT_JSON_DIR=./data/output

TIMEOUT=15
XUEQIU_REFERER=https://xueqiu.com/

# 雪球 cookies：代码通过 Playwright 自动刷新 xq_a_token，一般无需手工配置。
# 若环境无法跑浏览器，需本机先执行一次能拿到 cookies 的同步命令。
